<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Sidebar: 4 app slots + all apps -->
    <LinearLayout
        android:layout_width="104dp"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/sideSlots"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/btnApps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_apps" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Clock + now playing -->
            <LinearLayout
                android:id="@+id/leftCol"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/clockCard"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <com.carlauncher.AnalogClockView
                        android:id="@+id/analog"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:layout_weight="1.3"
                        android:orientation="vertical">

                        <TextClock
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:format12Hour="HH:mm"
                            android:format24Hour="HH:mm"
                            android:textColor="#FFFFFF"
                            android:textSize="38sp"
                            android:textStyle="bold" />

                        <TextClock
                            android:id="@+id/dateText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:format12Hour="d MMM yyyy"
                            android:format24Hour="d MMM yyyy"
                            android:textColor="#CCFFFFFF"
                            android:textSize="14sp" />

                        <TextClock
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:format12Hour="EEEE"
                            android:format24Hour="EEEE"
                            android:textColor="#99FFFFFF"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mediaCard"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="12dp"
                    android:layout_weight="1.6"
                    android:clickable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/mArt"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_disc" />

                    <TextView
                        android:id="@+id/mTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="Music"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/mSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="#AAFFFFFF"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/mPrev"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_sel"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="10dp"
                            android:src="@drawable/ic_prev" />

                        <ImageView
                            android:id="@+id/mPlay"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginLeft="8dp"
                            android:layout_marginRight="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="12dp"
                            android:src="@drawable/ic_play" />

                        <ImageView
                            android:id="@+id/mNext"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_sel"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="10dp"
                            android:src="@drawable/ic_next" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Hero: speedometer + moving road -->
            <FrameLayout
                android:id="@+id/heroCard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="12dp"
                android:layout_weight="6">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp">

                    <com.carlauncher.RoadView
                        android:id="@+id/road"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <com.carlauncher.SpeedometerView
                        android:id="@+id/speedo"
                        android:layout_width="440dp"
                        android:layout_height="350dp"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="12dp" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/btnSettings"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_tile"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="12dp"
                    android:src="@drawable/ic_settings" />
            </FrameLayout>
        </LinearLayout>

        <!-- Dock -->
        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:padding="6dp" />
    </LinearLayout>
</LinearLayout>
